<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Reporte de Productos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">

    <style>
        :root {
            --color-secondary: rgb(237, 237, 237);
            --color-main-table: rgb(204, 204, 204);
        }

        * {
            font-size: 10px;
        }

        .logotype {
            width: 50px !important;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .logotype a img {
            width: 100%;
            height: 100%;
        }

        .margin {
            width: 100%;
            height: 20px;
            background-color: var(--color-secondary);
        }

        .details {
            background-color: var(--color-secondary);
            display: flex;
            flex-direction: column;
            padding: 10px;
            border-radius: 5px;
        }

        .factura {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .container-boards {
            margin-top: 20px;
        }

        /* Tabla */
        .container-boards .cb-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            min-width: 500px;
        }

        .container-boards .cb-table .cb-headerTable th {
            text-align: center;
            background-color: var(--color-main-table);
            max-height: 36px;
            font-size: 8px;
            position: sticky;
            top: 0;
        }

        .container-boards .cb-table tbody tr:nth-child(odd) {
            background-color: rgba(225, 225, 225, 0.659);
        }

        .container-boards .cb-table tbody tr:nth-child(even) {
            background-color: #ffffff;
        }

        .container-boards .cb-table .cb-bodyTable td {
            text-align: center;
        }

        footer {
            margin-top: 20px;
        }

        .fe-card {
            width: 100%;
            background-color: var(--color-secondary);
            margin-bottom: 10px;
        }

        .fe-header {
            background-color: var(--color-main-table);
            font-weight: 700;
            padding: 5px;
            border-radius: 5px;
        }
    </style>
</head>

<body>

    <header>
        <div class="row">
            <div class="col-6 info-general">
                <div class="d-flex justify-content-center">
                    <div class="logotype">
                        <a href="www.yanditv.com">
                            <img src="https://erpuniversity.ucacue.edu.ec/img/logo_institucion.png" alt="Logo">
                        </a>
                    </div>
                </div>

                <div class="details" style="border-radius: 5px 5px 0 0;">
                    <span><b>Empresa: </b> {{details.nombreComercial}}</span>
                    <span><b>RUC: </b> {{details.ruc}}</span>
                    <span><b>Dirección: </b> {{details.direccion}}</span>
                    <span><b>Correo: </b> {{details.email}}</span>
                </div>
            </div>

            <div class="col-6">
                <div class="margin"></div>

                <div class="factura">
                    <b>REPORTE DE PRODUCTOS</b>
                    <b>{{date}}</b>
                </div>

                <div class="details">
                    <span><b>Total de Items: </b>{{totalItems}}</span>
                    <span><b>Generado por: </b>{{generatedBy}}</span>
                </div>
            </div>
        </div>
    </header>

    <main>
        <div class="container-boards">
            <table class="cb-table">
                <thead class="cb-header">
                    <tr class="cb-headerTable">
                        <th style="width: 10%;">ID</th>
                        <th style="width: 25%;">Nombre</th>
                        <th style="width: 15%;">Precio</th>
                        <th style="width: 35%;">Descripción</th>
                        <th style="width: 15%;">CategoriaId</th>
                    </tr>
                </thead>
                <tbody class="cb-bodyTable">
                    {{#each products}}
                    <tr>
                        <td>{{this.id}}</td>
                        <td>{{this.nombre}}</td>
                        <td>$ {{this.precio}}</td>
                        <td>{{this.descripcion}}</td>
                        <td>{{this.categoriaId}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </main>

    <footer>
        <div class="row">
            <div class="col-12">
                <div class="fe-card">
                    <label class="fe-header">
                        <span>Fin del Reporte</span>
                    </label>
                </div>
            </div>
        </div>
    </footer>

</body>

</html>